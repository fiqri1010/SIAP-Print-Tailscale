{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIAP Print Tailscale",
  "version": "1.4.3",
  "identifier": "com.kemenkeu.bcpriok.siapprint",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SIAP Print Tailscale - KPU Bea Cukai Tanjung Priok",
        "width": 880,
        "height": 680,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
