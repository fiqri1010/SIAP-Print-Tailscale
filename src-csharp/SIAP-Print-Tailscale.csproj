<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>SIAP-Print-Tailscale</AssemblyName>
    <RootNamespace>SiapPrintServer</RootNamespace>
    
    <Version>2.2.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <Title>SIAP Print Tailscale Server</Title>
    <Product>SIAP Print Tailscale</Product>
    <Company>KPPBC TMP A Tanjung Priok</Company>
    <Description>Server Pencetakan Mandiri Tailscale &amp; Native Windows PDF Engine untuk SIAP NEO (Ultra-Low Memory Edition)</Description>

    <!-- Optimasi Performa & Memori (Minimal RAM Footprint) -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
